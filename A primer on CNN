#Visualize Filters 

def visualize_filters(model, layer_name, num_filters=32):
    """Visualize the actual filter weights"""
    layer = model.get_layer(layer_name)
    filters = layer.get_weights()[0]

    # Normalize filters
    f_min, f_max = filters.min(), filters.max()
    filters = (filters - f_min) / (f_max - f_min)

    # Plot first num_filters
    n_cols = 8
    n_rows = num_filters // n_cols

    fig, axes = plt.subplots(n_rows, n_cols, figsize=(12, 6))
    for i, ax in enumerate(axes.flat):
        if i < num_filters:
            # Get filter (assumes 3x3 or similar small kernel)
            filter_img = filters[:, :, :, i]
            ax.imshow(filter_img[:, :, 0], cmap='gray')
        ax.axis('off')

    plt.suptitle(f'Filters from {layer_name}')
    plt.tight_layout()
    plt.show()

