def build_deep_model(input_dim, depth=3, units=64):
    model = keras.Sequential()
    model.add(layers.Input(shape=(input_dim,)))
    for _ in range(depth):
        model.add(layers.Dense(units, activation='relu'))
    model.add(layers.Dense(1))  # regression task

    model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.001, clipnorm=1.0),
      loss='mse', metrics=['mae']
    )
    return model

class GradientNormLog(tf.keras.callbacks.Callback):

    def __init__(self, x_sample, y_sample):
        super().__init__()
        self.x_sample = tf.convert_to_tensor(x_sample)
        self.y_sample = tf.convert_to_tensor(y_sample)
        self.grad_norms = []
        self.mean_abs_grads = []

    def on_train_batch_end(self, batch, logs=None):
        # Recompute gradients on the fixed sample batch
        with tf.GradientTape() as tape:
            y_pred = self.model(self.x_sample, training=True)
            # Use the same loss the model was compiled with
            loss = self.model.compiled_loss(self.y_sample, y_pred)

        grads = tape.gradient(loss, self.model.trainable_variables)
        grads = [g for g in grads if g is not None]


        norm = tf.linalg.global_norm(grads)
        self.grad_norms.append(float(norm.numpy()))

        mean_abs = tf.reduce_mean([tf.reduce_mean(tf.abs(g)) for g in grads])
        self.mean_abs_grads.append(float(mean_abs.numpy()))

